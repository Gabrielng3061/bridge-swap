# Chave privada da conta operadora / relayer (nunca commite o .env real)
PRIVATE_KEY=0xSUA_CHAVE_PRIVADA_AQUI

# RPCs Principais (Testnets)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ARBITRUM_SEPOLIA_RPC_URL=https://arbitrum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com
POLYGON_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# RPCs de Fallback opcionais (separados por vírgula)
SEPOLIA_FALLBACK_RPCS=
ARB_FALLBACK_RPCS=
BASE_FALLBACK_RPCS=
AMOY_FALLBACK_RPCS=

# Contratos por rede (substitua pelos endereços implantados)
SEPOLIA_TOKEN_CONTRACT=0x0000000000000000000000000000000000000000
SEPOLIA_BRIDGE_CONTRACT=0x0000000000000000000000000000000000000000

ARB_TOKEN_CONTRACT=0x0000000000000000000000000000000000000000
ARB_BRIDGE_CONTRACT=0x0000000000000000000000000000000000000000

BASE_TOKEN_CONTRACT=0x0000000000000000000000000000000000000000
BASE_BRIDGE_CONTRACT=0x0000000000000000000000000000000000000000

AMOY_TOKEN_CONTRACT=0x0000000000000000000000000000000000000000
AMOY_BRIDGE_CONTRACT=0x0000000000000000000000000000000000000000